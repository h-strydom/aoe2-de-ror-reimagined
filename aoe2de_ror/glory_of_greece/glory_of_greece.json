                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Capture the Artifact.\n• Escort the Artifact to your Government Center in the north of the map.",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
                           },
                           "TextRect": {
