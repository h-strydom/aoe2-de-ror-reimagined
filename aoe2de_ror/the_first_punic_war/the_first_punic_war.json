         "OutroSequence": {
            "SequenceItems": [
               {
                  "Type": "SlideShow",
                  "Data": {
                     "SlideImageSequence": "textures/campaign/the_first_punic_war/3/intro/%d.png",
                     "Sound": "rorri_the_first_punic_war_3_victory",
                     "Slides": [
                        {
                           "Duration": 26.0,
                           "TextFadeDuration": 25.8,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "You have snatched victory from near defeat! The Roman army has been crushed and Regulus sits in chains in your tent. Word has come that the fleeing survivors of the Roman fleet were caught in a storm and found their graves at the bottom of the sea. While your stunning victory has saved Carthage, you know that the Romans will never surrender. You fear that you have only delayed their eventual triumph.",
                           "ImageRect": {
