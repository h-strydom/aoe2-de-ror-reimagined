                              "width": 1300,
                              "height": 1350
                           }
                        }
                     ]
                  }
               }
            ]
         },
         "OutroSequence": {
            "SequenceItems": [
               {
                  "Type": "SlideShow",
                  "Data": {
                     "SlideImageSequence": "textures/campaign/enemies_of_rome/1/intro/%d.png",
                     "Sound": "rorri_enemies_of_rome_1_victory",
                     "Slides": [
                        {
                           "Duration": 10.8,
                           "TextFadeDuration": 10.6,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Your crossing of the Alps was a masterstroke in the annals of history. All of Carthage applauds you and your army. With Italy before you, Rome will feel your vengeance!",
