                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Destroy the Hittite Army (Brown).\n• Take back the ruined city of Babylon (Ruins).",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
