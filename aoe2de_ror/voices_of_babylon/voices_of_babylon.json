                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Destroy the Northern Aramaeans (Red).\n• Destroy the Western Aramaeans across the river (Yellow).",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
