                        },
                        {
                           "Duration": 6.0,
                           "TextFadeDuration": 5.8,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Return the statue of Marduk (Artifact) to its proper place (Temple).",
                           "ImageRect": {
