                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Destroy the Elamites.",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
                           },
                           "TextRect": {
                              "x": 230,
                              "y": 400,
                              "width": 1300,
                              "height": 1350
                           }
                        }
                     ]
