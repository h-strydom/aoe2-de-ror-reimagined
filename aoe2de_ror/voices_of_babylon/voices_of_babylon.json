                           "TextFadeDuration": 5.8,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objectives:\n• Capture the Artifact.",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
                           },
                           "TextRect": {
                              "x": 230,
