         },
         "OutroSequence": {
            "SequenceItems": [
               {
                  "Type": "SlideShow",
                  "Data": {
                     "SlideImageSequence": "textures/campaign/reign_of_the_hittites/3/intro/%d.png",
                     "Sound": "rorri_reign_of_the_hittites_3_victory",
                     "Slides": [
                        {
                           "Duration": 32.1,
                           "TextFadeDuration": 31.9,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Like the storm god, who slew the giant serpent Illuyanka with his thunderbolts, you drove the Egyptians before your chariots and turned them to dust and ash. In Egypt, the lamentations of the women will be heard for 40 days and there will be much gnashing of teeth. On the records of your people's history, kept within the archives at Hattusa, your name will be among the mightiest of Hittite kings, and your sons will carve your image into a great rock wall so that you will watch over your land for an eternity.",
                           "ImageRect": {
