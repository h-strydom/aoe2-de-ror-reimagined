                           }
                        },
                        {
                           "Duration": 6.0,
                           "TextFadeDuration": 5.8,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objective: Destroy the Canaanite Government Center in the city of Megiddo.",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
                           },
                           "TextRect": {
