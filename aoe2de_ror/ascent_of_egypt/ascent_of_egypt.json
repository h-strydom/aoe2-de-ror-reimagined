                           "TextFadeDuration": 12.200000000000001,
                           "FadeInTime": 0.2,
                           "FadeOutTime": 0.2,
                           "String": "Objective: Grow your tribe to 7 villagers.\n\n• Your Town Center supports only 4 villagers\n• You must build 1 House (supports 4 more villagers)\n• Houses cost 30 wood each\n• Villagers cost 50 food each",
                           "ImageRect": {
                              "x": 0,
                              "y": 0,
                              "width": 3840,
                              "height": 2160
